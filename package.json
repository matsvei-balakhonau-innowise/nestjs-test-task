{
  "name": "nestjs-test-task",
  "version": "0.1.0",
  "description": "NestJS ingest + audit microservices — Docker, MongoDB, Redis TimeSeries, event bus",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "build:apps": "npm run build -w ingest-service -w audit-service",
    "build": "npm run build:shared && npm run build:apps",
    "dev:ingest": "npm run start:dev -w ingest-service",
    "dev:audit": "npm run start:dev -w audit-service",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:clear-catalog": "docker exec nest-mongo mongosh nest_ingest --quiet --eval 'db.catalog_records.deleteMany({})'",
    "build:shared": "npm run build -w @shared/database -w @shared/http -w @shared/cache -w @shared/event-bus",
    "test": "npm run test -w @shared/http",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"shared/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=9"
  }
}
