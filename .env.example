# ingest-service HTTP
INGEST_PORT=3001

# audit-service HTTP
AUDIT_PORT=3002

# Mongo (official driver) — separate DBs per service
MONGO_URI=mongodb://mongo:27017
MONGO_DB_INGEST=nest_ingest
MONGO_DB_AUDIT=nest_audit

# Redis Stack (TimeSeries + Streams event bus)
REDIS_URL=redis://redis:6379

# Event bus (Redis Streams)
EVENT_STREAM_KEY=stream:ingest:actions
EVENT_GROUP=audit-consumers
EVENT_CONSUMER=audit-1

# /ingestion/pull SSRF guard — comma-separated hosts (* disables allow-list)
PULL_ALLOWED_HOSTS=jsonplaceholder.typicode.com,dummyjson.com
# Max response body size in bytes (default 10MB)
PULL_MAX_BYTES=10485760

# Local without Docker:
# MONGO_URI=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379
