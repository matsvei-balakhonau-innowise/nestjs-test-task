# Service A HTTP
SERVICE_A_PORT=3001

# Service B HTTP
SERVICE_B_PORT=3002

# Mongo (official driver) — separate DBs per service
MONGO_URI=mongodb://mongo:27017
MONGO_DB_A=nest_service_a
MONGO_DB_B=nest_service_b

# Redis Stack (TimeSeries + Streams event bus)
REDIS_URL=redis://redis:6379

# Event bus (Redis Streams)
EVENT_STREAM_KEY=stream:service-a:actions
EVENT_GROUP=service-b-consumers
EVENT_CONSUMER=service-b-1

# Local without Docker:
# MONGO_URI=mongodb://localhost:27017
# REDIS_URL=redis://localhost:6379
