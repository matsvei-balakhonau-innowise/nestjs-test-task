# Application
NODE_ENV=development

# Service A (HTTP + Redis microservice client)
SERVICE_A_PORT=3001
SERVICE_A_HOST=0.0.0.0

# Service B (HTTP + Redis microservice server)
SERVICE_B_PORT=3002
SERVICE_B_HOST=0.0.0.0

# MongoDB (official driver)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=nestjs_test_task

# Redis / RedisTimeSeries (redis-stack)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Inter-service messaging (Nest Redis transporter)
REDIS_MESSAGING_HOST=redis
REDIS_MESSAGING_PORT=6379

# Shared event channel / patterns
EVENTS_CHANNEL=service_a_events
